rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'aadityagarg.bt24meta@pec.edu.in'
      );
    }

    // Users Collection Rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Listings Collection Rules (Sellers manage their own; Admin can update upon product approval)
    match /listings/{listingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.sellerUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.sellerUid == request.auth.uid || isAdmin()
      );
    }

    // Requests Collection Rules
    match /requests/{requestId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.buyerUid ||
        request.auth.uid == resource.data.sellerUid
      );
      allow create: if isAuthenticated() && request.resource.data.buyerUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.sellerUid ||
        (request.auth.uid == resource.data.buyerUid && request.resource.data.status == 'cancelled')
      );
      allow delete: if isAuthenticated() && resource.data.buyerUid == request.auth.uid;
    }

    // Product Requests Collection Rules
    match /productRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.submittedBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Master Catalog Products Collection Rules
    match /masterProducts/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Catalog Taxonomy (Categories & Subcategories) Collection Rules
    match /catalogTaxonomy/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Legacy Approved Products Collection Rules (Backward Compatibility)
    match /approvedProducts/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Weekly Sales Aggregation Rules
    match /weeklySales/{salesId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['hostel', 'productId', 'productName', 'totalUnits', 'totalRevenue', 'updatedAt'])
        && request.resource.data.keys().hasAll(['hostel', 'productId', 'productName', 'totalUnits', 'totalRevenue', 'updatedAt'])
        && request.resource.data.totalUnits is number && request.resource.data.totalUnits > 0
        && request.resource.data.totalRevenue is number && request.resource.data.totalRevenue > 0;

      allow update: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['hostel', 'productId', 'productName', 'totalUnits', 'totalRevenue', 'updatedAt'])
        && request.resource.data.hostel == resource.data.hostel
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.totalUnits is number && request.resource.data.totalUnits > resource.data.totalUnits
        && request.resource.data.totalRevenue is number && request.resource.data.totalRevenue >= resource.data.totalRevenue;
    }

    // Product Suggestions Collection Rules
    match /productSuggestions/{suggestionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.voters;
      allow update: if isAuthenticated() && request.auth.uid in request.resource.data.voters;
    }
  }
}
